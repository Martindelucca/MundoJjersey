# Copy this file to .env.local in the repository root. Web and validation scripts share it.
# The Studio keeps its local variables in apps/studio/.env.local.
# Web Sanity read config. Required when the public site should read real products.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
SANITY_USE_CDN=true
# Optional read token for private datasets. Never prefix it with PUBLIC_.
SANITY_READ_TOKEN=

# Public site config.
PUBLIC_SITE_URL=http://localhost:4321
# International format, digits only recommended. Example: 5491112345678.
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_INSTAGRAM_URL=
PUBLIC_GA_MEASUREMENT_ID=

# Sanity Studio config.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
