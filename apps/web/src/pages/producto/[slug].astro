---
import ProductCard from '../../components/ProductCard.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductCategoryLabel } from '../../lib/catalog/categories';
import { getProductAvailability } from '../../lib/catalog/availability';
import { formatProductMetadata } from '../../lib/catalog/product-metadata';
import { getRelatedProducts } from '../../lib/catalog/related-products';
import { getImageSrcSet, getImageUrl } from '../../lib/sanity/image';
import { buildProductStructuredData } from '../../lib/seo';
import { parseSiteOrigin } from '../../lib/site-origin';
import { hasSanityConfig, sanityClient } from '../../lib/sanity/client';
import { productBySlugQuery, productSlugsQuery, productsQuery, siteSettingsQuery } from '../../lib/sanity/queries';
import type { ProductDetail, ProductSummary, SiteSettings } from '../../lib/sanity/types';
import { buildWhatsAppUrl } from '../../lib/whatsapp';

export async function getStaticPaths() {
  if (!hasSanityConfig) {
    return [];
  }

  const slugs = await sanityClient.fetch<Array<{ slug?: string }>>(productSlugsQuery);

  return slugs
    .filter(({ slug }) => Boolean(slug))
    .map(({ slug }) => ({ params: { slug } }));
}

const slug = Astro.params.slug || '';
const [product, settings, products] = hasSanityConfig
  ? await Promise.all([
      sanityClient.fetch<ProductDetail | null>(productBySlugQuery, { slug }),
      sanityClient.fetch<SiteSettings | null>(siteSettingsQuery),
      sanityClient.fetch<ProductSummary[]>(productsQuery)
    ])
  : [null, null, [] as ProductSummary[]];

const price = product
  ? new Intl.NumberFormat('es-AR', {
      style: 'currency',
      currency: 'ARS',
      maximumFractionDigits: 0
    }).format(product.price)
  : '';
const availability = product ? getProductAvailability(product) : { available: false, sizes: [], totalStock: null };
const categoryLabel = product ? getProductCategoryLabel(product.category) : 'Producto';
const productMetadata = product
  ? formatProductMetadata(product.brand, product.team?.name, product.season)
  : '';
const imageUrl = getImageUrl(product?.image, 960);
const imageSrcSet = getImageSrcSet(product?.image, [640, 960, 1280, 1600]);
const imageAlt = product?.image?.alt || product?.title || 'Producto de fútbol';
const whatsappNumber = settings?.whatsappNumber || import.meta.env.PUBLIC_WHATSAPP_NUMBER || '';
const siteOrigin = parseSiteOrigin(import.meta.env.PUBLIC_SITE_URL);
const productUrl = product && siteOrigin && !siteOrigin.isLocal
  ? new URL(`/producto/${product.slug}`, `${siteOrigin.origin}/`).toString()
  : undefined;
const whatsappUrl = product
  ? buildWhatsAppUrl({
      phoneNumber: whatsappNumber,
      productTitle: product.title,
      productCategory: categoryLabel,
      productUrl,
      messageTemplate: settings?.whatsappMessage
    })
  : '';
const relatedProducts = product
  ? getRelatedProducts(product, products)
  : [];
const canonicalProductUrl = productUrl;
const productStructuredData = product && canonicalProductUrl
  ? buildProductStructuredData(product, {
      url: canonicalProductUrl,
      imageUrl: imageUrl || undefined,
      category: categoryLabel,
      available: availability.available
    })
  : undefined;
---

<BaseLayout
  title={product ? `${product.title} | Mundo JJersey` : 'Producto no encontrado | Mundo JJersey'}
  description={product?.description || 'Detalle de producto disponible para consultar por WhatsApp.'}
  canonicalPath={product ? `/producto/${product.slug}` : undefined}
  structuredData={productStructuredData}
>
  <main id="contenido-principal" class="site-shell product-detail-page">
    <nav class="breadcrumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/catalogo">Catálogo</a>
      {product && <span aria-hidden="true">/</span>}
      {product && <span>{product.title}</span>}
    </nav>

    {product ? (
      <>
        <section class="product-detail" aria-labelledby="product-title">
          <div class="product-detail__media">
            {imageUrl ? <img src={imageUrl} srcset={imageSrcSet} sizes="(max-width: 780px) 100vw, 50vw" alt={imageAlt} loading="eager" fetchpriority="high" decoding="async" /> : <span class="product-detail__image-placeholder">Imagen pendiente</span>}
          </div>

          <div class="product-detail__content product-detail__sheet">
            <div class="product-detail__header">
              <p class="product-detail__kicker">{categoryLabel}</p>
              <h1 id="product-title">{product.title}</h1>
              {productMetadata && <p class="product-detail__meta">{productMetadata}</p>}
            </div>

            <div class="product-detail__commerce" aria-label="Precio y disponibilidad">
              <p class="product-detail__price">{price}</p>
              <p class={availability.available ? 'stock-label' : 'stock-label stock-label--empty'}>
                {availability.available
                  ? `${availability.totalStock} en tanda`
                  : 'Sin stock'}
              </p>
            </div>

            <div class="product-detail__sizes" aria-label="Talles y stock">
              <p>Talles y stock</p>
              <ul>
                {availability.sizes.map((size) => (
                  <li class={size.available ? '' : 'is-empty'}>
                    <span>{size.size}</span>
                    <small>{size.available ? 'disp.' : 'sin stock'}</small>
                  </li>
                ))}
              </ul>
            </div>

            <div class="product-detail__cta">
              <WhatsAppButton href={whatsappUrl} available={availability.available} productLabel={product.title} />
              <p class="product-detail__trust">El mensaje incluye este producto. Te respondemos por disponibilidad, talle y envío.</p>
            </div>

            {product.description && <p class="product-detail__description">{product.description}</p>}
          </div>
        </section>

        {relatedProducts.length > 0 && (
          <section class="related-products" aria-labelledby="related-products-title">
            <div>
              <p class="eyebrow">Seguís mirando la tanda</p>
              <h2 id="related-products-title">Más del perchero</h2>
            </div>
            <div class="product-grid">
              {relatedProducts.map((relatedProduct) => <ProductCard product={relatedProduct} headingLevel="h3" />)}
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="empty-state" aria-live="polite">
        <h1>Producto no encontrado</h1>
        <p>Volvé al catálogo para ver los productos disponibles.</p>
        <a class="button" href="/catalogo">Ir al catálogo</a>
      </section>
    )}
  </main>
</BaseLayout>
