---
import CatalogCategoryNavigation from '../../../components/CatalogCategoryNavigation.astro';
import CatalogProductGroups from '../../../components/CatalogProductGroups.astro';
import ShirtCollectionNavigation from '../../../components/ShirtCollectionNavigation.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCatalogCategoryBySlug } from '../../../lib/catalog/categories';
import { editorialCollections, getEditorialCollectionBySlug } from '../../../lib/catalog/editorial-collections';
import { fetchPublic } from '../../../lib/sanity/client';
import { productsByCategoryAndEditorialTagQuery } from '../../../lib/sanity/queries';
import type { ProductSummary } from '../../../lib/sanity/types';
import { getSiteContact } from '../../../lib/site-contact';
import { groupProductsByAvailability } from '../../../lib/catalog/availability';

export function getStaticPaths() {
  return editorialCollections.map((collection) => ({
    params: { category: 'camisetas', collection: collection.slug }
  }));
}

const categorySlug = Astro.params.category || '';
const collectionSlug = Astro.params.collection || '';
const category = getCatalogCategoryBySlug(categorySlug);
const collection = getEditorialCollectionBySlug(collectionSlug);
const products = category?.value === 'shirt' && collection
  ? await fetchPublic<ProductSummary[]>(productsByCategoryAndEditorialTagQuery, [], {
      category: category.value,
      editorialTag: collection.editorialTag
    })
  : [];
const productGroups = groupProductsByAvailability(products);
const hasVisibleProducts = productGroups.inStock.length + productGroups.onRequest.length > 0;
const siteContact = await getSiteContact();
const contactHref = siteContact.whatsappUrl || '#contacto';
const contactTarget = siteContact.whatsappUrl ? '_blank' : undefined;
const contactRel = siteContact.whatsappUrl ? 'noreferrer' : undefined;
---

<BaseLayout
  title={`${collection?.title || 'Camisetas'} | Mundo JJersey`}
  description={collection?.description || 'Camisetas de fútbol disponibles para consultar por WhatsApp.'}
  canonicalPath={`/catalogo/${categorySlug}/${collectionSlug}`}
>
  <main id="contenido-principal" class="site-shell catalog-page">
    <section class="catalog-hero catalog-hero--compact" aria-labelledby="catalog-collection-title">
      <h1 id="catalog-collection-title">{collection?.title}</h1>
      <p>{collection?.description}</p>
      <CatalogCategoryNavigation activeSlug={categorySlug} />
      <ShirtCollectionNavigation activeCollectionSlug={collection?.slug} />
    </section>

    {hasVisibleProducts ? (
      <CatalogProductGroups {...productGroups} />
    ) : (
      <section class="empty-state" aria-live="polite">
        <h2>{collection?.title} en preparación.</h2>
        <p>Cuando haya disponibilidad en esta colección, va a aparecer acá. También podés escribirnos si buscás un club, selección o temporada puntual.</p>
        <a class="button" href={contactHref} target={contactTarget} rel={contactRel}>Escribir por WhatsApp</a>
      </section>
    )}
  </main>
</BaseLayout>
