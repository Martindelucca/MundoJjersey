---
import ProductCard from '../components/ProductCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hasSanityConfig, sanityClient } from '../lib/sanity/client';
import { productsQuery } from '../lib/sanity/queries';
import type { ProductSummary } from '../lib/sanity/types';

const products = hasSanityConfig
  ? await sanityClient.fetch<ProductSummary[]>(productsQuery)
  : [];
---

<BaseLayout
  title="Catálogo | Mundo JJersey"
  description="Explorá camisetas de fútbol retro y actuales disponibles para consultar por WhatsApp."
>
  <main class="site-shell catalog-page">
    <section class="catalog-hero" aria-labelledby="catalog-title">
      <p class="eyebrow">Selección Mundo JJersey</p>
      <h1 id="catalog-title">Camisetas elegidas para usar con identidad.</h1>
      <p>Retro, clubes y selecciones con mirada streetwear. Mirá el stock real y consultá por WhatsApp la camiseta que te mueve.</p>
      <ul class="catalog-chips" aria-label="Categorías representadas en el catálogo">
        <li>Todo el catálogo</li>
        <li>Clubes</li>
        <li>Selecciones</li>
        <li>Retro</li>
      </ul>
    </section>

    {products.length > 0 ? (
      <section class="product-grid" aria-label="Productos">
        {products.map((product) => <ProductCard product={product} />)}
      </section>
    ) : (
      <section class="empty-state" aria-live="polite">
        <h2>Estamos preparando la próxima selección.</h2>
        <p>Las camisetas aparecen acá cuando el stock está listo para consultar. Volvé pronto o escribinos por WhatsApp si buscás un equipo en particular.</p>
      </section>
    )}
  </main>
</BaseLayout>
