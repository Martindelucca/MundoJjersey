---
import CategoryTile from '../components/CategoryTile.astro';
import FAQBlock from '../components/FAQBlock.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TrustBlock from '../components/TrustBlock.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catalogCategories } from '../lib/catalog/categories';
import { hasSanityConfig, sanityClient } from '../lib/sanity/client';
import { productsQuery } from '../lib/sanity/queries';
import type { ProductSummary } from '../lib/sanity/types';

const products = hasSanityConfig
  ? (await sanityClient.fetch<ProductSummary[]>(productsQuery)).slice(0, 4)
  : [];
---

<BaseLayout
  title="Mundo JJersey | Camisetas de fútbol retro y actuales"
  description="Camisetas de fútbol retro y actuales para consultar por WhatsApp."
>
  <main>
    <section class="hero drop-scene" aria-labelledby="home-title">
      <div class="site-shell hero__inner drop-scene__inner">
        <div class="drop-scene__copy">
          <p class="hero__stamp">Drop futbolero · stock real por talle</p>
          <h1 id="home-title">Ropa de fútbol con presencia de cancha y calle.</h1>
          <p class="hero__copy">
            Camisetas, camperas y shorts nuevos elegidos por diseño, talle y esa identidad que se nota antes de preguntar el precio.
          </p>
          <div class="hero__actions">
            <a class="button button--with-mark" href="/catalogo"><span>Ver catálogo</span><span aria-hidden="true">↗</span></a>
            <p>Nueva tanda lista para consultar por WhatsApp</p>
          </div>
        </div>

        <aside class="hero__spec-sheet" aria-label="Ficha de drop Mundo JJersey">
          <div class="hero__sheet-topline">
            <span>MJ-DROP</span>
            <span>2026</span>
          </div>
          <div class="hero__kit-frame" aria-hidden="true">
            <span class="hero__kit-collar"></span>
            <span class="hero__kit-body">MJJ</span>
            <span class="hero__kit-tag">nuevo</span>
          </div>
          <dl class="hero__drop-facts">
            <div><dt>Tipo</dt><dd>Camisetas / camperas / shorts</dd></div>
            <div><dt>Stock</dt><dd>por talle, sin vueltas</dd></div>
            <div><dt>Salida</dt><dd>consulta directa</dd></div>
          </dl>
          <p>Selección chica. Carga manual. Respuesta humana.</p>
        </aside>
      </div>

      <div class="drop-marquee" aria-hidden="true">
        <div>
          <span>Stock por talle</span>
          <span>Nuevos ingresos</span>
          <span>Consulta directa</span>
          <span>Fútbol para usar</span>
        </div>
      </div>
    </section>

    <section class="site-shell home-section home-section--arrivals">
      <SectionHeader
        label="Nuevos ingresos"
        title="Camisetas que acaban de entrar"
        copy="Una primera mirada a la selección más reciente. Si un producto te interesa, entrá al detalle y consultanos por WhatsApp."
      />

      {products.length > 0 ? (
        <div class="product-grid product-grid--home">
          {products.map((product) => <ProductCard product={product} />)}
        </div>
      ) : (
        <div class="empty-state empty-state--home" aria-live="polite">
          <h2>Estamos preparando los nuevos ingresos.</h2>
          <p>Los productos seleccionados van a aparecer acá apenas estén cargados. Mientras tanto, escribinos y te contamos qué hay disponible.</p>
          <a class="button" href="#contacto">Consultar por WhatsApp</a>
        </div>
      )}
    </section>

    <section class="home-section home-section--categories">
      <div class="site-shell categories__inner">
        <SectionHeader
          title="Entrá por categoría"
          copy="La selección se ordena como una tanda: camisetas como pieza principal, camperas para completar presencia y shorts para cerrar el conjunto."
        />

        <div class="category-grid category-grid--drop">
          {catalogCategories.map((category, index) => (
            <CategoryTile
              title={category.plural}
              copy={category.description}
              href={`/catalogo/${category.slug}`}
              label={index === 0 ? 'pieza principal' : index === 1 ? 'capa exterior' : 'cierre de conjunto'}
              tone={index === 0 ? 'primary' : index === 1 ? 'secondary' : 'quiet'}
              featured={index === 0}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="site-shell home-section about-section" aria-labelledby="about-title">
      <div class="about-section__panel">
        <p class="about-section__label">Mundo JJersey</p>
        <h2 id="about-title">Camisetas para usar, guardar y volver a mirar.</h2>
      </div>
      <div class="about-section__copy">
        <p>
          Nacimos de mirar la ropa de fútbol como algo más que indumentaria: colores que te llevan a un partido, una temporada, una selección o una forma de vestir fútbol en la calle.
        </p>
        <p>
          Elegimos cada ingreso con criterio: diseño, talle, demanda y ese punto especial que hace que una prenda destaque antes de preguntar el precio.
        </p>
      </div>
    </section>

    <section class="site-shell home-section trust-section">
      <SectionHeader
        title="Consultá con confianza"
        copy="La compra se coordina persona a persona. Preguntá disponibilidad, talle, envío o formas de pago antes de avanzar."
        variant="compact"
      />

      <div class="trust-grid">
        <TrustBlock title="WhatsApp directo" copy="Respondemos consultas de producto, talle y disponibilidad sin pasos raros." />
        <TrustBlock title="Pago a coordinar" copy="Te contamos las formas de pago disponibles antes de confirmar el producto." />
        <TrustBlock title="Envios" copy="Coordinamos el envío según tu ubicación y el producto elegido." />
        <TrustBlock title="Cambios y consultas" copy="Si necesitás revisar talle, estado o detalle, lo vemos con vos antes de cerrar." />
      </div>
    </section>

    <section class="site-shell home-section faq-section">
      <SectionHeader
        title="Preguntas antes de escribir"
        copy="Lo básico para llegar a WhatsApp con todo más claro."
        variant="compact"
      />
      <FAQBlock />
    </section>
  </main>
</BaseLayout>
