---
import CategoryTile from '../components/CategoryTile.astro';
import FAQBlock from '../components/FAQBlock.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { Image } from 'astro:assets';
import heroImage from '../../fotos/HERODESKTOP.svg';
import camperasImage from '../../fotos/camperas.jpg';
import clubesImage from '../../fotos/clubes2.jpg';
import aboutImage from '../../fotos/nosotros.JPEG';
import retroImage from '../../fotos/retro.jpg';
import seleccionesImage from '../../fotos/selecciones.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catalogCategories } from '../lib/catalog/categories';
import { fetchPublic } from '../lib/sanity/client';
import { productsQuery } from '../lib/sanity/queries';
import type { ProductSummary } from '../lib/sanity/types';
import { getSiteContact } from '../lib/site-contact';

const products = (await fetchPublic<ProductSummary[]>(productsQuery, [])).slice(0, 4);
const siteContact = await getSiteContact();
const contactHref = siteContact.whatsappUrl || '#contacto';
const contactTarget = siteContact.whatsappUrl ? '_blank' : undefined;
const contactRel = siteContact.whatsappUrl ? 'noreferrer' : undefined;
const editorialCategories = [
  {
    title: 'Clubes',
    label: 'identidad de tribuna',
    copy: 'Camisetas de clubes con temporada, color y presencia para usar fuera de la cancha.',
    href: '/catalogo/camisetas/clubes',
    imageSrc: clubesImage,
    imageAlt: 'Camiseta retro de Bayer Leverkusen colgada en un estudio',
    cue: 'Ver clubes',
    variant: 'poster' as const,
    tone: 'primary' as const,
    featured: true
  },
  {
    title: 'Selecciones',
    label: 'mundial y calle',
    copy: 'Piezas de selección para quienes buscan fútbol reconocible sin caer en uniforme común.',
    href: '/catalogo/camisetas/selecciones',
    imageSrc: seleccionesImage,
    imageAlt: 'Camiseta de Argentina colgada en una percha',
    cue: 'Ver selecciones',
    variant: 'fresh' as const,
    tone: 'secondary' as const
  },
  {
    title: 'Retro',
    label: 'temporadas con historia',
    copy: 'Diseños que remiten a una época, una camiseta titular o una suplente difícil de olvidar.',
    href: '/catalogo/camisetas/retro',
    imageSrc: retroImage,
    imageAlt: 'Camiseta retro presentada como pieza de archivo',
    cue: 'Ver retro',
    variant: 'archive' as const,
    tone: 'secondary' as const
  },
  {
    title: 'Camperas',
    label: 'abrigo de cancha',
    copy: 'Abrigo con identidad de cancha para usar todos los días.',
    href: '/catalogo/camperas',
    imageSrc: camperasImage,
    imageAlt: 'Campera de fútbol colgada en una percha',
    cue: 'Ver camperas',
    variant: 'poster' as const,
    tone: 'quiet' as const
  }
];
---

<BaseLayout
  title="Mundo JJersey | Camisetas de fútbol retro y actuales"
  description="Camisetas de fútbol retro y actuales para consultar por WhatsApp."
>
  <main id="contenido-principal">
    <section class="hero drop-scene" aria-labelledby="home-title">
      <div class="hero__poster" aria-hidden="true">
        <Image src={heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
      </div>
      <div class="site-shell hero__inner drop-scene__inner">
        <div class="drop-scene__copy">
          <h1 id="home-title">Fútbol para vestir todos los días.</h1>
          <p class="hero__copy">
            Camisetas seleccionadas por club, selección y temporada. Stock real por talle y consulta directa desde cada ficha.
          </p>
          <div class="hero__actions">
            <a class="button button--with-mark" href="/catalogo"><span>Ver catálogo</span><span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <section id="nuevos-ingresos" class="site-shell home-section home-section--arrivals">
      <SectionHeader
        title="Recién colgadas"
        copy="La tanda nueva va apareciendo acá: clubes, selecciones y retro con stock confirmado por talle."
      />

      {products.length > 0 ? (
        <div class="product-grid product-grid--home">
          {products.map((product) => <ProductCard product={product} headingLevel="h3" />)}
        </div>
      ) : (
        <div class="empty-state empty-state--home" aria-live="polite">
          <h2>Estamos preparando los nuevos ingresos.</h2>
          <p>Los productos aparecen acá cuando la tanda está lista. Mientras tanto, mandanos el club o selección que buscás y revisamos el perchero.</p>
          <a class="button" href={contactHref} target={contactTarget} rel={contactRel}>Escribir por WhatsApp</a>
        </div>
      )}
    </section>

    <section class="home-section home-section--categories">
      <div class="site-shell categories__inner">
        <SectionHeader
          title="Entrá por cultura, no por góndola"
          copy="Buscá como busca un hincha: club, selección, retro o campera. Si preferís ir por prenda, también tenés accesos rápidos."
        />

        <div class="category-grid category-grid--drop">
          {editorialCategories.map((category) => (
            <CategoryTile
              title={category.title}
              copy={category.copy}
              href={category.href}
              label={category.label}
              tone={category.tone}
              featured={category.featured}
              imageSrc={category.imageSrc}
              imageAlt={category.imageAlt}
              cue={category.cue}
              variant={category.variant}
            />
          ))}
        </div>

        <div class="garment-routes" aria-label="Buscar por tipo de prenda">
          <p>Buscar por prenda</p>
          <div>
            {catalogCategories.map((category) => <a href={`/catalogo/${category.slug}`}>{category.plural}</a>)}
          </div>
        </div>
      </div>
    </section>

    <section id="sobre-nosotros" class="site-shell home-section about-section" aria-labelledby="about-title">
      <div class="about-section__media">
        <Image
          src={aboutImage}
          alt="Los amigos detrás de Mundo JJersey cuando eran chicos."
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-section__copy">
        <h2 id="about-title">Sobre nosotros</h2>
        <p>
          Somos Mundo JJersey, amigos de toda la vida. Creamos este proyecto para compartir nuestra selección de camisetas actuales y retro de colección.
        </p>
        <p>
          Sabemos lo difícil que es encontrar esa camiseta que buscás. Tenemos algunos modelos en stock y también traemos camisetas a pedido.
        </p>
        <p>Trabajamos con líneas Premium y revisamos cada camiseta antes de sumarla al catálogo.</p>
      </div>
    </section>

    <section class="site-shell home-section faq-section">
      <SectionHeader
        title="Preguntas antes de escribir"
        copy="Lo que suele importar antes de reservar una camiseta."
        variant="compact"
      />
      <FAQBlock />
    </section>

    <section class="site-shell home-section final-cta" aria-labelledby="final-cta-title">
      <div>
        <p class="final-cta__label">¿Buscás un modelo?</p>
        <h2 id="final-cta-title">¿No encontraste la camiseta que buscás?</h2>
        <p>Escribinos por WhatsApp. Contanos el club, la temporada y el talle que buscás; vemos si podemos conseguirla para vos.</p>
      </div>
      <a class="button button--with-mark" href={contactHref} target={contactTarget} rel={contactRel}><span>Consultar un modelo</span><span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>
