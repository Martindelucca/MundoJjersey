---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mundo JJersey | Camisetas de futbol retro y actuales"
  description="Catalogo administrable de camisetas de futbol retro y actuales para consultar por WhatsApp."
>
  <main class="site-shell">
    <section class="hero" aria-labelledby="home-title">
      <p class="eyebrow">Catalogo administrable</p>
      <h1 id="home-title">Mundo JJersey</h1>
      <p class="hero__copy">
        Camisetas de futbol retro y actuales seleccionadas para consultar directo por WhatsApp.
      </p>
      <a class="button" href="/catalogo">Ver catalogo</a>
    </section>
  </main>
</BaseLayout>
