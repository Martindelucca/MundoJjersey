---
import CategoryTile from '../components/CategoryTile.astro';
import FAQBlock from '../components/FAQBlock.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TrustBlock from '../components/TrustBlock.astro';
import heroPosterImage from '../../fotos/HERO1.jpg';
import actualImage from '../../fotos/actual.jpg';
import clubesImage from '../../fotos/clubes2.jpg';
import retroImage from '../../fotos/retro.jpg';
import seleccionesImage from '../../fotos/selecciones.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catalogCategories } from '../lib/catalog/categories';
import { hasSanityConfig, sanityClient } from '../lib/sanity/client';
import { productsQuery } from '../lib/sanity/queries';
import type { ProductSummary } from '../lib/sanity/types';
import { getSiteContact } from '../lib/site-contact';

const products = hasSanityConfig
  ? (await sanityClient.fetch<ProductSummary[]>(productsQuery)).slice(0, 4)
  : [];
const siteContact = await getSiteContact();
const contactHref = siteContact.whatsappUrl || '#contacto';
const contactTarget = siteContact.whatsappUrl ? '_blank' : undefined;
const contactRel = siteContact.whatsappUrl ? 'noreferrer' : undefined;
const editorialCategories = [
  {
    title: 'Clubes',
    label: 'identidad de tribuna',
    copy: 'Camisetas de clubes con temporada, color y presencia para usar fuera de la cancha.',
    href: '/catalogo/camisetas',
    imageSrc: clubesImage.src,
    imageAlt: 'Camiseta retro de Bayer Leverkusen colgada en un estudio',
    cue: 'Ver clubes',
    variant: 'poster' as const,
    tone: 'primary' as const,
    featured: true
  },
  {
    title: 'Selecciones',
    label: 'mundial y calle',
    copy: 'Piezas de selección para quienes buscan fútbol reconocible sin caer en uniforme común.',
    href: '/catalogo/camisetas',
    imageSrc: seleccionesImage.src,
    imageAlt: 'Camiseta de Argentina colgada en una percha',
    cue: 'Ver selecciones',
    variant: 'fresh' as const,
    tone: 'secondary' as const
  },
  {
    title: 'Retro',
    label: 'temporadas con historia',
    copy: 'Diseños que remiten a una época, una camiseta titular o una suplente difícil de olvidar.',
    href: '/catalogo/camisetas',
    imageSrc: retroImage.src,
    imageAlt: 'Camiseta retro presentada como pieza de archivo',
    cue: 'Ver retro',
    variant: 'archive' as const,
    tone: 'secondary' as const
  },
  {
    title: 'Nuevos ingresos',
    label: 'stock chico',
    copy: 'La tanda más reciente para revisar talle real y reservar por WhatsApp antes de que vuele.',
    href: '#nuevos-ingresos',
    imageSrc: actualImage.src,
    imageAlt: 'Camiseta actual colgada en una percha',
    cue: 'Ver tanda',
    variant: 'fresh' as const,
    tone: 'quiet' as const
  }
];
---

<BaseLayout
  title="Mundo JJersey | Camisetas de fútbol retro y actuales"
  description="Camisetas de fútbol retro y actuales para consultar por WhatsApp."
>
  <main id="contenido-principal">
    <section class="hero drop-scene" aria-labelledby="home-title">
      <div class="hero__poster" aria-hidden="true">
        <img src={heroPosterImage.src} alt="" loading="eager" />
      </div>
      <div class="site-shell hero__inner drop-scene__inner">
        <div class="drop-scene__copy">
          <h1 id="home-title">Fútbol para vestir todos los días.</h1>
          <p class="hero__copy">
            Camisetas seleccionadas por club, selección y temporada. Stock real por talle y consulta directa desde cada ficha.
          </p>
          <div class="hero__actions">
            <a class="button button--with-mark" href="/catalogo"><span>Ver catálogo</span><span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <section id="nuevos-ingresos" class="site-shell home-section home-section--arrivals">
      <SectionHeader
        title="Lo último que entró al perchero"
        copy="Modelos recién cargados para revisar talle, precio y disponibilidad antes de separar por WhatsApp."
      />

      {products.length > 0 ? (
        <div class="product-grid product-grid--home">
          {products.map((product) => <ProductCard product={product} />)}
        </div>
      ) : (
        <div class="empty-state empty-state--home" aria-live="polite">
          <h2>Estamos preparando los nuevos ingresos.</h2>
          <p>Los productos aparecen acá cuando la tanda está lista. Mientras tanto, mandanos el club o selección que buscás y revisamos el perchero.</p>
          <a class="button" href={contactHref} target={contactTarget} rel={contactRel}>Escribir por WhatsApp</a>
        </div>
      )}
    </section>

    <section class="home-section home-section--categories">
      <div class="site-shell categories__inner">
        <SectionHeader
          title="Entrá por cultura, no por góndola"
          copy="Buscá como busca un hincha: club, selección, retro o tanda nueva. Las prendas quedan abajo, como ruta secundaria."
        />

        <div class="category-grid category-grid--drop">
          {editorialCategories.map((category) => (
            <CategoryTile
              title={category.title}
              copy={category.copy}
              href={category.href}
              label={category.label}
              tone={category.tone}
              featured={category.featured}
              imageSrc={category.imageSrc}
              imageAlt={category.imageAlt}
              cue={category.cue}
              variant={category.variant}
            />
          ))}
        </div>

        <div class="garment-routes" aria-label="Buscar por tipo de prenda">
          <p>También podés buscar por tipo de prenda</p>
          <div>
            {catalogCategories.map((category) => <a href={`/catalogo/${category.slug}`}>{category.plural}</a>)}
          </div>
        </div>
      </div>
    </section>

    <section id="sobre-nosotros" class="site-shell home-section about-section" aria-labelledby="about-title">
      <div class="about-section__panel">
        <p class="about-section__label">Mundo JJersey</p>
        <h2 id="about-title">No cargamos por cargar.</h2>
      </div>
      <div class="about-section__copy">
        <p>
          Miramos cada camiseta como club, selección y temporada. Si no tiene estado claro, talle confirmado o buena presencia, no entra al catálogo.
        </p>
        <p>
          La idea es simple: pocas prendas, fotos cuidadas, stock real y una respuesta humana para separar sin vueltas.
        </p>
        <ul class="about-section__proof" aria-label="Criterios de selección">
          <li>Temporada visible</li>
          <li>Talle confirmado</li>
          <li>Stock chico</li>
        </ul>
      </div>
    </section>

    <section class="site-shell home-section trust-section">
      <SectionHeader
        title="Consultá con confianza"
        copy="Antes de reservar, resolvemos lo que importa: talle, estado, precio, envío y forma de pago."
        variant="compact"
      />

      <div class="trust-grid">
        <TrustBlock title="Stock por talle" copy="No vendemos a ciegas. Cada ficha separa disponibilidad real por talle cargado." />
        <TrustBlock title="Link directo por camiseta" copy="Cada ficha abre WhatsApp con el modelo cargado para no explicar de cero." />
        <TrustBlock title="Envío coordinado" copy="Vemos ubicación, tiempos y costo según la camiseta elegida." />
        <TrustBlock title="Medidas antes de separar" copy="Si dudás con el talle, revisamos medidas y detalles por mensaje." />
      </div>
    </section>

    <section class="site-shell home-section faq-section">
      <SectionHeader
        title="Preguntas antes de escribir"
        copy="Lo básico para llegar a WhatsApp con todo más claro."
        variant="compact"
      />
      <FAQBlock />
    </section>

    <section class="site-shell home-section final-cta" aria-labelledby="final-cta-title">
      <div>
        <p class="final-cta__label">Consulta directa</p>
        <h2 id="final-cta-title">¿Viste una camiseta para separar?</h2>
        <p>Abrí la ficha de la camiseta y escribinos desde ahí para confirmar talle, precio y envío.</p>
      </div>
      <a class="button button--with-mark" href={contactHref} target={contactTarget} rel={contactRel}><span>Escribir por WhatsApp</span><span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>
