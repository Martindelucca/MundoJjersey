---
interface Props {
  whatsappUrl?: string;
  instagramUrl?: string;
}

const { whatsappUrl = '', instagramUrl = '' } = Astro.props;
const footerLinks = [
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/#nuevos-ingresos', label: 'Nuevos ingresos' },
  { href: '/catalogo/camisetas', label: 'Camisetas' },
  { href: '/catalogo/camperas', label: 'Camperas' },
  { href: '/catalogo/conjuntos', label: 'Conjuntos' },
  { href: '/catalogo/shorts', label: 'Shorts' }
];
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="contacto">
  <div class="site-footer__inner site-shell">
    <div class="site-footer__brand">
      <a class="site-footer__brand-link" href="/" aria-label="Mundo JJersey inicio">
        <span class="site-footer__mark" aria-hidden="true"><img src="/brand-mark.png" alt="" width="512" height="512" loading="lazy" /></span>
        <span>Mundo JJersey</span>
      </a>
      <p>Prendas y conjuntos de fútbol para vestirlo todos los días.</p>
    </div>

    <div class="site-footer__navigation site-footer__navigation--desktop">
      <p class="site-footer__label">Explorar</p>
      <nav class="site-footer__links" aria-label="Explorar el catálogo">
        {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>

    <div class="site-footer__contact" aria-label="Contacto directo">
      <p class="site-footer__label">¿Tenés una consulta?</p>
      <div class="site-footer__contact-links">
        {whatsappUrl ? (
          <a class="site-footer__contact-link site-footer__contact-link--primary" href={whatsappUrl} target="_blank" rel="noreferrer">Escribir por WhatsApp</a>
        ) : (
          <p class="contact-unavailable">WhatsApp no está configurado todavía.</p>
        )}
        {instagramUrl ? <a class="site-footer__contact-link site-footer__contact-link--instagram" href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> : null}
      </div>
    </div>

    <details class="site-footer__mobile-navigation">
      <summary>Explorar</summary>
      <nav class="site-footer__links" aria-label="Explorar el catálogo">
        {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </details>
  </div>
  <div class="site-footer__bottom site-shell">
    <p>© {currentYear} Mundo JJersey</p>
    <p>Catálogo de camisetas nuevas · Consultas por WhatsApp</p>
  </div>
</footer>
