---
interface Props {
  href: string;
  available: boolean;
  productLabel?: string;
}

const { href, available, productLabel = 'este producto' } = Astro.props;
const label = available ? `Consultar ${productLabel} por WhatsApp` : `Consultar disponibilidad de ${productLabel} por WhatsApp`;
---

{href ? (
  <a class="whatsapp-button" href={href} target="_blank" rel="noreferrer" aria-label={label}>
    <span class="whatsapp-button__label">{available ? 'Consultar por WhatsApp' : 'Consultar disponibilidad'}</span>
    <span class="whatsapp-button__mark" aria-hidden="true">↗</span>
  </a>
) : (
  <p class="contact-unavailable">WhatsApp no está configurado todavía.</p>
)}
