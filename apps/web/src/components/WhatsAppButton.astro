---
interface Props {
  href: string;
  available: boolean;
}

const { href, available } = Astro.props;
const label = available ? 'Preguntar por esta camiseta por WhatsApp' : 'Consultar reposición por WhatsApp';
---

{href ? (
  <a class="whatsapp-button" href={href} target="_blank" rel="noreferrer" aria-label={label}>
    <span class="whatsapp-button__label">{available ? 'Preguntar por esta camiseta' : 'Consultar reposición'}</span>
    <span class="whatsapp-button__hint">El mensaje ya sale con esta camiseta cargada</span>
  </a>
) : (
  <p class="contact-unavailable">WhatsApp no está configurado todavía.</p>
)}
