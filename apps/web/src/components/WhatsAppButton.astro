---
interface Props {
  href: string;
  available: boolean;
  productLabel?: string;
}

const { href, available, productLabel = 'este producto' } = Astro.props;
const label = available ? `Consultar ${productLabel} por WhatsApp` : 'Consultar disponibilidad por WhatsApp';
---

{href ? (
  <a class="whatsapp-button" href={href} target="_blank" rel="noreferrer" aria-label={label}>
    <span class="whatsapp-button__label">{available ? 'Consultar este producto' : 'Consultar disponibilidad'}</span>
    <span class="whatsapp-button__hint">El mensaje ya sale con este producto cargado</span>
  </a>
) : (
  <p class="contact-unavailable">WhatsApp no está configurado todavía.</p>
)}
