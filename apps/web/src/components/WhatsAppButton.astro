---
import type { ProductAvailabilityStatus } from '../lib/sanity/types';

interface Props {
  href: string;
  status: ProductAvailabilityStatus;
  productLabel?: string;
}

const { href, status, productLabel = 'este producto' } = Astro.props;
const isOnRequest = status === 'onRequest';
const available = status === 'inStock';
const label = isOnRequest
  ? `Pedir ${productLabel} por WhatsApp`
  : available
    ? `Reservar ${productLabel} por WhatsApp`
    : `Consultar disponibilidad de ${productLabel} por WhatsApp`;
---

{href ? (
  <a class="whatsapp-button" href={href} target="_blank" rel="noreferrer" aria-label={label}>
    <span class="whatsapp-button__label">{isOnRequest ? 'Pedir por WhatsApp' : available ? 'Reservar por WhatsApp' : 'Consultar disponibilidad'}</span>
    <span class="whatsapp-button__mark" aria-hidden="true">↗</span>
  </a>
) : (
  <p class="contact-unavailable">WhatsApp no está configurado todavía.</p>
)}
