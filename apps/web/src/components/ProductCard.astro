---
import { getImageUrl } from '../lib/sanity/image';
import type { ProductSummary } from '../lib/sanity/types';
import { getProductCategoryLabel } from '../lib/catalog/categories';
import { getAvailableSizes, getTotalStock, isAvailable as hasAvailableStock } from '../lib/catalog/availability';

interface Props {
  product: ProductSummary;
}

const { product } = Astro.props;
const imageUrl = getImageUrl(product.image, 640);
const variants = product.variants || [];
const totalStock = getTotalStock(variants);
const isAvailable = hasAvailableStock(variants);
const availableSizes = getAvailableSizes(variants);
const stockLabel = isAvailable ? 'Disponible' : 'Sin stock';
const categoryLabel = getProductCategoryLabel(product.category);
const teamLabel = product.team?.name || 'Equipo a confirmar';
const seasonLabel = product.season || 'Tanda actual';
const sizesPreview = availableSizes.length > 0
  ? `Talles ${availableSizes.slice(0, 4).join(' / ')}${availableSizes.length > 4 ? ' +' : ''}`
  : 'Consultar reposición';
const stockText = isAvailable ? `${totalStock} en tanda` : 'Sin stock · preguntá reposición';
const price = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: 'ARS',
  maximumFractionDigits: 0
}).format(product.price);
---

<article class="product-card">
  <a class="product-card__media" href={`/producto/${product.slug}`} aria-label={`Ver ${product.title}`}>
    <span class={isAvailable ? 'product-card__badge' : 'product-card__badge product-card__badge--empty'}>
      {stockLabel}
    </span>
    <span class="product-card__season">{seasonLabel}</span>
    {imageUrl ? (
      <img src={imageUrl} alt={product.image?.alt || product.title} loading="lazy" />
    ) : (
      <span class="product-card__placeholder" aria-hidden="true"><span>MJJ</span><small>Imagen pendiente</small></span>
    )}
  </a>
  <div class="product-card__body">
    <div class="product-card__ticket" aria-label="Datos rápidos del producto">
      <span>{product.brand}</span>
      <span>{categoryLabel}</span>
      <span>{teamLabel} · {seasonLabel}</span>
    </div>
    <p class="product-card__meta">{categoryLabel} · {sizesPreview}</p>
    <h2><a href={`/producto/${product.slug}`}>{product.title}</a></h2>
    <div class="product-card__details">
      <p class="product-card__price">{price}</p>
      <p class={isAvailable ? 'product-card__stock' : 'product-card__stock product-card__stock--empty'}>
        {stockText}
      </p>
    </div>
  </div>
</article>
