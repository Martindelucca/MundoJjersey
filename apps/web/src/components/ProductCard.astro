---
import { getImageSrcSet, getImageUrl } from '../lib/sanity/image';
import type { ProductSummary } from '../lib/sanity/types';
import { getProductAvailability } from '../lib/catalog/availability';
import { formatProductMetadata } from '../lib/catalog/product-metadata';

interface Props {
  product: ProductSummary;
  headingLevel?: 'h2' | 'h3';
}

const { product, headingLevel = 'h2' } = Astro.props;
const imageUrl = getImageUrl(product.image, 640);
const imageSrcSet = getImageSrcSet(product.image, [320, 480, 640, 960, 1280]);
const availability = getProductAvailability(product);
const availableSizes = availability.sizes.filter((size) => size.available).map((size) => size.size);
const stockLabel = availability.available ? 'Disponible' : 'Sin stock';
const identity = formatProductMetadata(product.brand, product.team?.name, product.season);
const sizesPreview = availableSizes.length > 0
  ? `Talles ${availableSizes.slice(0, 4).join(' / ')}${availableSizes.length > 4 ? ' +' : ''}`
  : 'Consultar disponibilidad';
const price = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: 'ARS',
  maximumFractionDigits: 0
}).format(product.price);
---

<article class="product-card">
  <a class="product-card__media" href={`/producto/${product.slug}`} aria-label={`Ver ${product.title}`}>
    <span class={availability.available ? 'product-card__badge' : 'product-card__badge product-card__badge--empty'}>
      {stockLabel}
    </span>
    {imageUrl ? (
      <img src={imageUrl} srcset={imageSrcSet} sizes="(max-width: 359px) 100vw, (max-width: 780px) 50vw, (max-width: 1119px) 50vw, 547px" alt={product.image?.alt || product.title} loading="lazy" decoding="async" />
    ) : (
      <span class="product-card__placeholder" aria-hidden="true"><span>MJJ</span><small>Imagen pendiente</small></span>
    )}
  </a>
  <div class="product-card__body">
    {identity && <p class="product-card__identity">{identity}</p>}
    {headingLevel === 'h3' ? (
      <h3><a href={`/producto/${product.slug}`}>{product.title}</a></h3>
    ) : (
      <h2><a href={`/producto/${product.slug}`}>{product.title}</a></h2>
    )}
    <div class="product-card__details">
      <p class="product-card__price">{price}</p>
      <p class="product-card__sizes">{sizesPreview}</p>
    </div>
  </div>
</article>
