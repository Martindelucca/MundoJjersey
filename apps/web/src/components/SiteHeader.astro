---
interface Props {
  whatsappUrl?: string;
}

const pathname = Astro.url.pathname;
const primaryLinks = [
  { href: '/#nuevos-ingresos', label: 'Nuevos ingresos', shortLabel: 'Nuevos ingresos' },
  { href: '#contacto', label: 'Contacto', shortLabel: 'Contacto' }
];
const mobileLinks = [
  { href: '/catalogo', label: 'Ver catálogo' },
  { href: '/#nuevos-ingresos', label: 'Nuevos ingresos' },
  { href: '#contacto', label: 'Contacto' },
  { href: '/#sobre-nosotros', label: 'Sobre nosotros' }
];

function isCurrentLink(href: string): boolean {
  if (href === '/') {
    return pathname === '/';
  }

  if (href.startsWith('#')) {
    return false;
  }

  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="site-header__inner site-shell">
    <a class="site-header__brand" href="/" aria-label="Mundo JJersey inicio">
      <span class="site-header__mark" aria-hidden="true">
        <img src="/brand-mark.png" alt="" width="512" height="512" loading="eager" />
      </span>
      <span class="site-header__brand-copy">
        <span>Mundo JJersey</span>
        <small>Camisetas seleccionadas</small>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Navegacion principal">
      {primaryLinks.map((link) => (
        <a href={link.href} aria-current={isCurrentLink(link.href) ? 'page' : undefined}>
          <span class="site-header__label-full">{link.label}</span>
          <span class="site-header__label-short" aria-hidden="true">{link.shortLabel}</span>
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a class="site-header__cta" href="/catalogo">
        <span class="site-header__cta-hole" aria-hidden="true"></span>
        <span class="site-header__cta-full">Ver catálogo</span>
        <span class="site-header__cta-short" aria-hidden="true">Catálogo</span>
      </a>
    </div>

    <details class="site-header__menu">
      <summary>Menú</summary>
      <div class="site-header__menu-panel">
        {mobileLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.site-header__menu').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      const link = (event.target as Element).closest('a');

      if (link && menu.contains(link)) {
        menu.removeAttribute('open');
      }
    });

  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') {
      return;
    }

    const openMenus = [...document.querySelectorAll<HTMLDetailsElement>('.site-header__menu[open]')];

    if (openMenus.length === 0) {
      return;
    }

    const focusedMenu = openMenus.find((menu) => menu.contains(document.activeElement));
    openMenus.forEach((menu) => menu.removeAttribute('open'));
    (focusedMenu ?? openMenus[0]).querySelector('summary')?.focus();
  });
</script>
